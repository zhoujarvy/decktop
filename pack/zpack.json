      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Windows\\System32\\curl.exe",
            "argsRegex": "^-s -m [0-9]+ -H Authorization: Bearer \\S+ https?://[a-zA-Z0-9.-]+:9932/api/[a-zA-Z0-9/_-]+$"
          }
        ]
