      ],
      "includeFiles": [
        "*.js",
        "*.png",
        "**/*.html",
        "**/*.css",
        "**/*.js",
        "**/*.png"
      ]
    },
    {
      "name": "weather",
      "htmlPath": "weather/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "504px",
          "width": "340px",
          "height": "144px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "*.png",
        "**/*.html",
        "**/*.css",
        "**/*.js",
        "**/*.png"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Windows\\System32\\curl.exe",
            "argsRegex": "^-s -4 --compressed -m [0-9]+ -H X-QW-Api-Key: [A-Za-z0-9]{8,64} https://devapi\\.qweather\\.com/v7/weather/(now|7d)\\?location=[A-Za-z0-9.,-]{2,32}$|^-s -4 --compressed -m [0-9]+ https://geocoding-api\\.open-meteo\\.com/v1/search\\?name=[^&]+&count=1&language=zh&format=json$"
          }
        ]
      }
    },
    {
      "name": "glm-balance",
      "htmlPath": "glm-balance/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
