{
  "$schema": "https://raw.githubusercontent.com/glzr-io/zebar/main/resources/zpack-schema.json",
  "name": "decktop",
  "version": "0.2.0",
  "description": "桌面小组件套件：本机状态/时钟农历/日历/天气7天/GLM Code Plan 用量/NAS 监控，插件化卡片 + 可视化设置（中英双语），卡片可拖动磁吸排列",
  "tags": [
    "dashboard",
    "clock",
    "calendar",
    "weather",
    "monitor",
    "chinese"
  ],
  "previewImages": [
    "./resources/preview-1.png"
  ],
  "repositoryUrl": "https://github.com/zhoujarvy/decktop",
  "widgets": [
    {
      "name": "system",
      "htmlPath": "system/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "16px",
          "width": "340px",
          "height": "112px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "*.png",
        "**/*.html",
        "**/*.css",
        "**/*.js",
        "**/*.png"
      ]
    },
    {
      "name": "clock",
      "htmlPath": "clock/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "140px",
          "width": "340px",
          "height": "100px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "*.png",
        "**/*.html",
        "**/*.css",
        "**/*.js",
        "**/*.png"
      ]
    },
    {
      "name": "calendar",
      "htmlPath": "calendar/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
