{
  "$schema": "https://raw.githubusercontent.com/glzr-io/zebar/main/resources/zpack-schema.json",
  "name": "desktop-widgets",
  "version": "0.2.0",
  "description": "个人桌面小组件：本机/时钟/日历/天气/GLM/NAS（插件化，可视化配置）",
  "widgets": [
    {
      "name": "system",
      "htmlPath": "system/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "16px",
          "width": "340px",
          "height": "112px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ]
    },
    {
      "name": "clock",
      "htmlPath": "clock/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "140px",
          "width": "340px",
          "height": "100px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ]
    },
    {
      "name": "calendar",
      "htmlPath": "calendar/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "252px",
          "width": "340px",
          "height": "240px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ]
    },
    {
      "name": "weather",
      "htmlPath": "weather/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "504px",
          "width": "340px",
          "height": "144px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ]
    },
    {
      "name": "glm-balance",
      "htmlPath": "glm-balance/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "660px",
          "width": "340px",
          "height": "116px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Windows\\System32\\curl.exe",
            "argsRegex": "^-s -m [0-9]+ -H Authorization: Bearer [A-Za-z0-9._-]+ https://open\\.bigmodel\\.cn/api/(biz/account/query-customer-account-report|monitor/usage/quota/limit)$"
          }
        ]
      }
    },
    {
      "name": "nas",
      "htmlPath": "nas/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "788px",
          "width": "340px",
          "height": "208px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Windows\\System32\\curl.exe",
            "argsRegex": "^-s -m [0-9]+ -H Authorization: Bearer \\S+ https?://[a-zA-Z0-9.-]+:9932/api/[a-zA-Z0-9/_-]+$"
          }
        ]
      }
    },
    {
      "name": "settings-bar",
      "htmlPath": "settings-bar/index.html",
      "zOrder": "bottom_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "1008px",
          "width": "340px",
          "height": "36px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Program Files\\glzr.io\\Zebar\\zebar.exe",
            "argsRegex": "^start-widget-preset --pack desktop-widgets --widget-name settings --preset default$"
          }
        ]
      }
    },
    {
      "name": "settings",
      "htmlPath": "settings/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-16px",
          "offsetY": "16px",
          "width": "380px",
          "height": "640px",
          "monitorSelection": {
            "type": "primary"
          }
        }
      ],
      "includeFiles": [
        "*.js",
        "**/*.html",
        "**/*.css",
        "**/*.js"
      ]
    }
  ]
}
