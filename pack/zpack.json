        "**/*.js",
        "**/*.png"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Windows\\System32\\curl.exe",
            "argsRegex": "^-s -m [0-9]+ -H Authorization: Bearer [A-Za-z0-9._-]+ https://open\\.bigmodel\\.cn/api/(biz/account/query-customer-account-report|monitor/usage/quota/limit)$"
          }
